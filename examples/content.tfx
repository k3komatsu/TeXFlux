        通信路 & AWGN，周波数選択性レイリーフェージング \\ \hline

    !before{\vspace{1em}}:
        \headuline{CA}{独立$L$波周波数選択性レイリーフェージング}
        @align*:
            h[n] = \begin{cases}
            \mathcal{CN}(0, 1/L) & n < L \\
            0 & \text{otherwise}
            \end{cases}


