%     {
%         \input{../plot/ber_256_160_Rayleigh.pgf}
%     }
%     \end{center}


%     \begin{itemize}
%         \item<only@1> サブキャリア数$N=160$，圧縮率$\alpha=0.625$
%         \item<only@1> EP法のみ復調可能
%         \item<only@2> 純OFDMの理論より良い復調特性\\
%         プリコーディングにより周波数方向に拡散
%     \end{itemize}
% \end{frame}



@frame[t,noframenumbering]{最尤推定法（MLD）に基づく復調手法}: |
    送信シンボルを網羅的に全探索する手法
    !items:
        - すべての候補で以下のコスト関数を計算
          \begin{align*}
          \mathcal{J}(\mathmat{x}) = \| \mathmat{y} - \mathmat{W}_{\alpha} \mathmat{x} \|^2
          \end{align*}
        - コスト関数が最小の候補を送信信号と推定
        - サブキャリア数$N$の\TextCB{指数関数で計算時間増加} \\
          例１：QPSKの$N$サブキャリアで$4^N$個の候補\\
          例２：BPSKで$N = 2$なら4個の候補
          \begin{align*}
          \mathmat{x} \in \Brkts{ \begin{bmatrix}+1\\+1\end{bmatrix}, \begin{bmatrix}-1\\+1\end{bmatrix}, \begin{bmatrix}+1\\-1\end{bmatrix}, \begin{bmatrix}-1\\-1\end{bmatrix} }
          \end{align*}


@frame[t,fragile,noframenumbering]{固有モード伝送（EMT）法}: |
    \only<1>: |
        !vpad{-0.5em}: |
            \scalebox{0.85}: |
                \small
                \input{figs/sefdm_evd.tex}

        !items:
            - 変調行列の特異値分解（SVD）$\mathmat{W}_{\alpha} = \mathmat{U} \mathmat{S} \mathmat{V}^{H}$
            - 特異ベクトル$\mathmat{U}, \mathmat{V}$でプリ/ポストコーディング
            - 特異値の逆数$\mathmat{S}^{-1}$で最適電力割当

    \only<2>: |
        @infobox{EMT法の利点} >> !items:
            - 送受信機での処理が簡単
            - チャネル推定が完全なら誤り率特性も最適
        !vpad{1em}: |
            @alertbox{EMT法の欠点} >> !items:
                - ランク落ちや特異値に小さな値がある場合に\\対応するモードでの伝送を諦める必要がある\\
                - \TextCB{帯域を狭くすればするほど伝送レードも低下}


@frame[t,noframenumbering]{変調行列の特異値分布（$N=256$）} >> !vpad{-2em}: |
    % \begin{minipage}[t]{0.49\textwidth}
    \centering
    \scalebox{0.50}: |
        \input{../plot/eigen_values_256.pgf}



    !items:
        - 帯域を圧縮率するほど小さな特異値の割合が増加
        - 計算誤差によるEVMの増加$\rightarrow$ ビット誤り率の増大


@frame[t,noframenumbering]{EMT法のエラーベクトル振幅（EVM）} >> !vpad{-2em}: |
    % \begin{minipage}[t]{0.49\textwidth}
    \centering
    \scalebox{0.50}: |
        \input{../plot/evd_evm.pgf}

    % \begin{itemize}
    %     \item 帯域を圧縮率するほど小さな固有値の割合が増加
    %     \item 計算誤差によるEVMの増加$\rightarrow$ ビット誤り率の増大
    % \end{itemize}
    !vpad{-0.5em} >> !items:
        - サブキャリア数が大きいと少しの圧縮でEVM劣化
        - \TextCB{$N=256$ではほとんど圧縮不可}


@frame[t,noframenumbering]{既存のSEFDMの復調方法（まとめ）} >> !vpad{-2em}: |
    @center: |
        \renewcommand\arraystretch{2}
        \tabcolsep = 0.1cm
        @tabular{cccc}: |
            基礎技術 & 復調性能 & 計算量 & 問題点 \\ \hline
            最尤推定 & ○○ & ×× & \TextCB{指数計算量} \\ \hline
            固有モード伝送 & ○ & ○ & \TextCB{小さな特異値の問題} \\ \hline
            確率推論　& ○ & ○ & \textcolor{black!20}{小さな$N$で性能劣化} \\ \hline

    % \begin{itemize}
    %     \item 基本的にはMIMO伝送の復調方式と同等な\\アルゴリズムによって復調可能
    %     \item それぞれ一長一短があるのが現状
    % \end{itemize}
    !items:
        - 一般的なOFDMのサブキャリア数$N \geq 50$
        - 最尤推定・固有モード伝送は$N$が大きくなればなるほど\TextCB{問題点がより厳しくなってくる}
        - 確率推論は\TextCA{$N$が大きいほうが有利}



@frame[t,noframenumbering]{確率推論に基づく手法}: |
    % \begin{infobox}{AWGN線形通信路モデル}
    %     ある線形システム$\mathmat{A}$とAWGN通信路$\mathmat{w}$を通って受信された受信ベクトル$\mathmat{y}$から送信信号ベクトル$\mathmat{x} \sim p(\mathmat{x})$を推定したい
    %     \begin{align*}
    %         \mathmat{y} = \mathmat{z} + \mathmat{w};\;\;\;\; \mathmat{z} = \mathmat{A} \mathmat{x}
    %     \end{align*}
    % \end{infobox}

    @infobox{確率推論}: |
        送信信号$\mathmat{x}$の事前確率$p(\mathmat{x})$や通信路の確率モデル$\mathmat{p}(\mathmat{y}|\mathmat{z} = \mathmat{A}\mathmat{x})$を利用して送信信号$\mathmat{x}$を推定する

    確率モデル上でのメッセージ伝播アルゴリズム
    !items:
        - 並列干渉除去と信号推定を繰り返し動作
        - バリエーションが存在（GaBP, AMP, EP）
        - 大システム極限の仮定\\
          \TextCA{サブキャリア数$N$が大きいときに性能発揮}
          % \begin{itemize}
          %     \item ガウス信念伝播法（GaBP）
          %     \item 近似的メッセージ伝播法（AMP）
          %     \item 期待値伝播法（EP）
          % \end{itemize}


    % \vspace{1em}

    % \begin{alertbox}{}
    %     \centering
    %     大システムを仮定しているのでサブキャリア数$N$が\\小さいときに著しく性能劣化
    % \end{alertbox}




@frame[t,noframenumbering]{性能評価：諸元} >> !vpad{-0.5em}: |
    % {
    % \centering
    @center >> @tabular{c|c}: |
        \hline
        % Parameter & Value \\ \hline
        サブキャリア変調 & QPSK \\ \hline
        FFTサイズ & 16, 64, 256 \\ \hline
        圧縮率 & 0.625 \\ \hline
        サブキャリア数 & 10, 40, 160 \\ \hline
    % }

    @{}: |
        以下の手法でビット誤り率を比較
        !items:
            - 最尤推定法（MLD）
            - QR分解MアルゴリズムMLD法（QRM-MLD）
            - 固有モード伝送法（EMT）
            - 確率推論系
                - ガウス信念伝播法（GaBP）
                - 近似的メッセージ伝播法（AMP）
                - 期待値伝播法（EP）


@frame[t,noframenumbering]{AWGN，$N=10$，$\alpha=0.625$　}: |
    !vpad{-1em} >> @center: |
        % \scalebox{0.58}{
        % \input{../plot/ber_16_10_AWGN_forslide.pgf}
        % }
        \includegraphics[page=1,width=0.74\textwidth]{plot_pdfs.pdf}

    !vpad{-1.5em} >> !items:
        -<only@1> 小規模SEFDMで\textcolor{C3}{固有モード伝送（EMT）}は\\無圧縮のOFDMと同じBER特性を達成
        -<only@1> \textcolor{C5}{最尤推定（MLD）系}はOFDMより少し劣化
        -<only@2> 確率推論系は\TextCB{全く復調できない}\\
          $\rightarrow$ 大システム極限の仮定が成立しないため


@frame[t,noframenumbering]{AWGN，$N=40$，$\alpha=0.625$　}: |
    !vpad{-1em} >> @center: |
        \includegraphics[page=2,width=0.74\textwidth]{plot_pdfs.pdf}

    !vpad{-1.5em} >> !items:
        -<only@1> 中規模SEFDMではどの手法も復調困難
        -<only@1> MLD系は計算量・探索空間の問題によりBER増加
        -<only@1> EMT法はEVMの劣化によるBER増加
        -<only@2> サブキャリア数$N=40$程度では確率推論系も\\まだうまく動かない


@frame[t,noframenumbering]{ハール・プリコーディング有無の比較}: |
    !vpad{-1em} >> @center: |
        \includegraphics[page=4,width=0.74\textwidth]{plot_pdfs.pdf}

    !vpad{-1.5em} >> !items:
        - 大規模SEFDM（$N=160$, $\alpha=0.625$）で送信側のハール・プリコーディングの有無でBERを比較
        - \TextCA{プリコーディングにより復調性能が大幅に改善}
