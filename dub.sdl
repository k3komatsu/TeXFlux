name "texflux"
description "A TeX-first indentation-based preprocessor for structural LaTeX boilerplate"
license "0BSD"
targetType "executable"
targetName "texflux"
targetPath "bin"
mainSourceFile "source/texflux/app.d"

// Keep the explicit nesting guard usable on Windows, whose default PE stack
// reserve is smaller than the POSIX runner's stack.
lflags-windows-x86_64-ldc "/STACK:8388608"

// The bundled standard flow macros are source, not documentation: the D
// compiler embeds this package resource into every product configuration.
stringImportPaths "source/texflux"

configuration "application" {
	targetType "executable"
}

configuration "library" {
	targetType "library"
	excludedSourceFiles "source/texflux/app.d"
}

configuration "unittest" {
	targetType "executable"
	targetName "texflux-test"
	sourcePaths "source" "tests/d"
	importPaths "source" "tests/d"
}

// Explicit maintenance tool. It rewrites the frozen regression fixture only
// when the caller opts in with --accept-current.
configuration "update-regression" {
	targetType "executable"
	targetName "update-regression"
	mainSourceFile "tools/update_regression.d"
	sourcePaths "source" "tests/d" "tools"
	importPaths "source" "tests/d" "tools"
	excludedSourceFiles "source/texflux/app.d"
}
